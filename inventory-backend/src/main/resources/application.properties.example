server.port=8081

# --- MySQL (set DB_USER / DB_PASSWORD or edit locally; never commit real values) ---
spring.datasource.url=jdbc:mysql://localhost:3306/INVENTORY
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false

# --- JWT (set JWT_SECRET to a long random Base64 string; do not commit a real secret) ---
app.jwt.secret=${JWT_SECRET:}
app.jwt.expiration-ms=28800000

# --- CORS (comma separated origins; "*" is for development only) ---
app.cors.allowed-origins=${CORS_ORIGINS:*}
# --- Login protection ---
app.security.max-failed-attempts=5
app.security.lock-minutes=15